services:
  syncthing:
    image: lscr.io/linuxserver/syncthing:v2.1.5-ls230
    container_name: syncthing
    environment:
      - PUID={{ media.puid}}
      - PGID={{ media.pgid}}
      - TZ={{ timezone }}
      # - UMASK_SET=022
    healthcheck:
      test: ["CMD-SHELL", "curl --max-time  4.9 -s http://localhost:8384"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 5s
    ports:
      - 8384:8384
      - 22000:22000
      - 21027:21027/udp
    restart: unless-stopped
    volumes:
      - ./data:/config
      - {{ media.books_dir }}:/data/syncthing/books
