services:
  pocket-id:
    image: ghcr.io/pocket-id/pocket-id:v2.16.0
    container_name: pocket-id
    environment:
      TZ: "{{ timezone }}"
      DB_CONNECTION_STRING: "postgres://{{ pocketid.postgres.user }}:{{ pocketid.postgres.password }}@{{ postgres.host }}:{{ postgres.port }}/{{ pocketid.postgres.name }}"
      ENCRYPTION_KEY: "{{ pocketid.encryption_key }}"
      ANALYTICS_DISABLED: "true"
      APP_URL: {{ pocketid.app_url }}
      PUID: {{ pocketid.puid }}
      PGID: {{ pocketid.pgid }}
      TRUST_PROXY: "true"
      UI_CONFIG_DISABLED: "true"
      # 31 days session duration
      SESSION_DURATION: 111600
      EMAILS_VERIFIED: true
      ALLOW_USER_SIGNUPS: disabled
    healthcheck:
      test: [ "CMD", "/app/pocket-id", "healthcheck" ]
      interval: 30s
      timeout: 5s
      retries: 2
      start_period: 10s
    labels:
      traefik.enable: true
      traefik.docker.network: web
      traefik.http.routers.pocketid.rule: Host(`{{ traefik.hosts.pocketid }}`)
      traefik.http.routers.pocketid.entrypoints: websecure
      traefik.http.routers.pocketid.middlewares: chain-no-auth-without-rate-limit@file
      # TLS stuff
      traefik.http.routers.pocketid.tls: true
      traefik.http.routers.pocketid.tls.certresolver: letsencrypt
      traefik.http.services.pocketid.loadbalancer.server.port: 1411
    networks:
      - postgres_shared
      - web
    read_only: true
    restart: unless-stopped
    user: "1000:1000"
    volumes:
      - ./data:/app/data

networks:
  postgres_shared:
    external: true
  web:
    external: true
